# Never point automated tests at the production Supabase project.
VITE_SUPABASE_URL=https://TEST_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TEST_BRANCH_PUBLISHABLE_KEY
VECTA_TEST_DATABASE_ONLY=true

# Vercel Preview uses these separate variables. Never copy production values here.
VECTA_TEST_SUPABASE_URL=https://TEST_PROJECT_REF.supabase.co
VECTA_TEST_SUPABASE_PUBLISHABLE_KEY=TEST_BRANCH_PUBLISHABLE_KEY
VECTA_TEST_SUPABASE_SERVICE_ROLE_KEY=TEST_BRANCH_SERVICE_ROLE_KEY
