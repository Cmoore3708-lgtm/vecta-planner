{
  "version": 2,
  "regions": ["lhr1"],
  "crons": [
    { "path": "/api/fleet-nightly-refresh", "schedule": "30 22 * * *" },
    { "path": "/api/nmuk-service-reminders-summer", "schedule": "0 11 * * *" },
    { "path": "/api/nmuk-service-reminders-winter", "schedule": "0 12 * * *" }
  ],
  "functions": {
    "api/fleet-nightly-refresh.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/booking/", "destination": "/booking.html" },
    { "source": "/api/nmuk-service-reminders-summer", "destination": "/api/fleet-nightly-refresh?task=nmuk-summer" },
    { "source": "/api/nmuk-service-reminders-winter", "destination": "/api/fleet-nightly-refresh?task=nmuk-winter" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] }
  ]
}
