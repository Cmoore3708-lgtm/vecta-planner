{
  "version": 2,
  "rewrites": [
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/booking/", "destination": "/booking.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] }]
}
