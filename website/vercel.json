{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/haynes-image",
      "destination": "https://vecta-planner.vercel.app/api/haynes-image"
    },
    {
      "source": "/api/haynes-vehicle",
      "destination": "https://vecta-planner.vercel.app/api/haynes-vehicle"
    },
    {
      "source": "/api/customer-history",
      "destination": "https://vecta-planner.vercel.app/api/customer-history"
    },
    {
      "source": "/privacy",
      "destination": "https://vecta-website-4mhfbwna9-vectaplanner.vercel.app/privacy"
    },
    {
      "source": "/terms",
      "destination": "https://vecta-website-4mhfbwna9-vectaplanner.vercel.app/terms"
    }
  ],
  "functions": {
    "api/vehicle-lookup.js": {
      "maxDuration": 30
    },
    "api/availability.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/booking",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/booking/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
