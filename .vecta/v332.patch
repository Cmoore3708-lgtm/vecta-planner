+<script id="v332-completed-service-authority">
+/* V332 — completed service evidence is authoritative only after every cloud source
+   has loaded. This prevents an older Fleet snapshot from putting serviced vehicles
+   back into Due next 30 days. */
+(function(){
+'use strict';
+function reg(value){return String(value||'').toUpperCase().replace(/[^A-Z0-9]/g,'');}
+function iso(value){var match=String(value||'').match(/\d{4}-\d{2}-\d{2}/);return match?match[0]:'';}
+function addMonths(date,months){
+  if(typeof fleetAddMonthsFromDue==='function')return fleetAddMonthsFromDue(date,months);
+  var d=new Date(date+'T00:00:00');if(isNaN(d.getTime()))return '';
+  var day=d.getDate();d.setDate(1);d.setMonth(d.getMonth()+Number(months||0));
+  d.setDate(Math.min(day,new Date(d.getFullYear(),d.getMonth()+1,0).getDate()));
+  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
+}
+function done(job){
+  if(!job)return false;
+  var status=String(job.status||'').toLowerCase().replace(/\s+/g,'_');
+  return status==='completed'||status==='complete'||status==='ready_to_invoice'||status==='ready_for_invoice'||status==='invoiced'||status==='invoice_created'||job.archived===true||!!job.completed_at||!!job.completedAt;
+}
+function deleted(job){
+  if(!job)return true;
+  try{if(typeof vectaJobIsDeletedForLists==='function'&&vectaJobIsDeletedForLists(job))return true;}catch(e){}
+  return String(job.status||'').toLowerCase()==='deleted'||/\[\[VECTA_SOFT_DELETE:/i.test(String(job.customer_note||''));
+}
+function serviceJob(job){
+  if(!job||deleted(job)||!done(job))return false;
+  try{if(typeof isSixMonthSafetyCheck==='function'&&isSixMonthSafetyCheck(job))return false;}catch(e){}
+  try{var cats=typeof fleetPlannerJobCategories==='function'?fleetPlannerJobCategories(job):{};if(cats&&cats.service)return true;}catch(e){}
+  var values=[];
+  if(Array.isArray(job.job_types))values=values.concat(job.job_types);
+  [job.job_type,job.type,job.service_type,job.work_required].forEach(function(v){if(v)values.push(v);});
+  return /\b(?:on[ -]?site|internal|annual|full|major|interim)\s+service\b|\boil\s*(?:&|and)?\s*filter(?:\s+change)?\b/i.test(values.join(' '));
+}
+function jobDate(job){return iso(job&&job.completed_at)||iso(job&&job.completedAt)||iso(job&&job.booking_date)||iso(job&&job.updated_at)||iso(job&&job.created_at);}
+function recordKind(record){
+  try{if(typeof serviceRecordKind==='function')return String(serviceRecordKind(record)||'').toLowerCase();}catch(e){}
+  return String(record&&(record.sheet_type||record.kind)||'service').toLowerCase();
+}
+function evidenceByRegistration(){
+  var latest={},jobsById={};
+  ((typeof app!=='undefined'&&app&&Array.isArray(app.jobs))?app.jobs:[]).forEach(function(job){
+    if(job&&job.id)jobsById[String(job.id)]=job;
+    if(!serviceJob(job))return;
+    var key=reg(job.registration),date=jobDate(job);if(key&&date&&(!latest[key]||date>latest[key].date))latest[key]={date:date,source:'job:'+String(job.id||'')};
+  });
+  ((typeof app!=='undefined'&&app&&Array.isArray(app.serviceRecords))?app.serviceRecords:[]).forEach(function(record){
+    if(!record)return;var kind=recordKind(record);if(kind!=='service'&&kind!=='onsite'&&kind!=='on-site')return;
+    var linked=jobsById[String(record.job_id||'')],key=reg(record.registration||(linked&&linked.registration)),date=jobDate(linked)||iso(record.completed_at)||iso(record.completedDate)||iso(record.saved_at)||iso(record.updated_at)||iso(record.created_at);
+    if(key&&date&&(!latest[key]||date>latest[key].date))latest[key]={date:date,source:'paperwork:'+String(record.id||record.job_id||'')};
+  });
+  return latest;
+}
+function activeServicePlans(vehicle){
+  return ((typeof fleetPlans!=='undefined'&&Array.isArray(fleetPlans))?fleetPlans:[]).filter(function(plan){
+    if(!plan||String(plan.vehicleId)!==String(vehicle.id)||String(plan.status||'Active')!=='Active')return false;
+    try{if(typeof fleetIsMaintenanceRemoved==='function'&&fleetIsMaintenanceRemoved(plan.vehicleId,plan.type))return false;}catch(e){}
+    try{return typeof fleetMaintenanceCategory==='function'?fleetMaintenanceCategory(plan.type)==='service':/service/i.test(String(plan.type||''));}catch(e){return /service/i.test(String(plan.type||''));}
+  });
+}
+function repair(){
+  if(typeof fleetVehicles==='undefined'||!Array.isArray(fleetVehicles)||typeof fleetPlans==='undefined'||!Array.isArray(fleetPlans))return {changed:0,matched:0};
+  var evidence=evidenceByRegistration(),changed=0,matched=0;
+  fleetVehicles.forEach(function(vehicle){
+    var item=evidence[reg(vehicle&&vehicle.registration)];if(!item)return;
+    var plans=activeServicePlans(vehicle);if(!plans.length)return;matched++;
+    var next=addMonths(item.date,12);if(!next)return;
+    plans.sort(function(a,b){
+      var ad=iso(a.currentDueDate),bd=iso(b.currentDueDate),aProtected=a.manualDueDate===true&&ad>=next,bProtected=b.manualDueDate===true&&bd>=next;
+      if(aProtected!==bProtected)return aProtected?-1:1;
+      return String(ad||'9999-12-31').localeCompare(String(bd||'9999-12-31'));
+    });
+    var plan=plans[0];
+    var current=iso(plan.currentDueDate);
+    /* Never drag a genuinely later user-entered date backwards. */
+    if(!current||current<next){plan.currentDueDate=next;plan.targetMonth=Number(next.slice(5,7));plan.intervalMonths=12;plan.manualDueDate=false;plan.notes='Next service due 12 months after completed service '+item.date+' ('+item.source+').';changed++;}
+    plans.slice(1).forEach(function(other){if(String(other.status||'Active')==='Active'){other.status='Superseded';other.notes='Superseded by completed service evidence dated '+item.date+'.';changed++;}});
+  });
+  if(changed){try{if(typeof saveFleet==='function')saveFleet();}catch(e){console.warn('V332 Fleet save failed',e);}}
+  return {changed:changed,matched:matched};
+}
+window.v332RepairCompletedServices=repair;
+/* pullRemote returns only after jobs, Fleet data and saved paperwork have all loaded. */
+try{
+  if(typeof pullRemote==='function'&&!pullRemote.__v332CompletedService){
+    var oldPull=pullRemote;
+    pullRemote=async function(){var result=await oldPull.apply(this,arguments),audit=repair();if(audit.changed&&typeof render==='function')render();return result;};
+    pullRemote.__v332CompletedService=true;
+  }
+}catch(e){console.warn('V332 completed-service cloud wrapper skipped',e);}
+try{
+  if(typeof fleetBind==='function'&&!fleetBind.__v332CompletedService){
+    var oldBind=fleetBind;
+    fleetBind=function(){var audit=repair(),result=oldBind.apply(this,arguments);if(audit.changed)setTimeout(function(){try{if(typeof render==='function'&&view==='fleet')render();}catch(e){}},0);return result;};
+    fleetBind.__v332CompletedService=true;
+  }
+}catch(e){console.warn('V332 completed-service Fleet wrapper skipped',e);}
+setTimeout(function(){try{var audit=repair();if(audit.changed&&typeof render==='function')render();}catch(e){console.warn('V332 initial completed-service repair failed',e);}},7000);
+})();
 </script>
 
